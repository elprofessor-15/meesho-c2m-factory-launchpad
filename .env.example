# Paste secrets only into .env.local. Never into chat or NEXT_PUBLIC variables.
NEXT_PUBLIC_APP_NAME="C2M Launchpad"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_DATA_MODE="local"
DEMO_MODE="true"
DEMO_DATE="2026-10-04"

# Hosted persistence: enable anonymous sign-ins and apply supabase/migrations first.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Legacy anon key is also accepted in PUBLISHABLE_KEY. No admin key is needed.

# LLM fallback order. Only configured providers are called. Failed providers are skipped for the rest of the turn.
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
LLM_PROVIDERS="groq,gemini,openrouter"
GEMINI_TEXT_MODEL="gemini-3.8-flash"
GROQ_TEXT_MODEL="openai/gpt-oss-20b"
OPENROUTER_MODEL="openrouter/free"

# STT primary and fallback (same Groq key as above).
ELEVENLABS_API_KEY=""
STT_PROVIDERS="groq,elevenlabs"
GROQ_STT_MODEL="whisper-large-v3-turbo"
ELEVENLABS_STT_MODEL="scribe_v2"

# Cloud TTS: Gemini, eligible ElevenLabs Free speech, then matching device speech.
TTS_PROVIDERS="gemini,elevenlabs,browser"
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
GEMINI_TTS_VOICE="Kore"
ELEVENLABS_TTS_MODEL="eleven_multilingual_v2"
# Premade Sarah voice supports multilingual speech and was tested on a Free account.
# Library/professional voices can require a paid plan even when credits remain.
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"
TTS_BROWSER_FALLBACK="true"
# ElevenLabs Free supports Scribe STT API allowance; Free API TTS with library voices returns paid_plan_required.
ALLOW_PAID_SPEECH_FALLBACK="false"
# Enable Free-tier STT and TTS fallback. Free status and disabled overage are verified.
# TTS also checks remaining account characters before sending text.
ENABLE_ELEVENLABS_FREE_TIER="false"

AI_MAX_INPUT_TOKENS="4000"
AI_MAX_OUTPUT_TOKENS="500"
AI_MAX_MODEL_CALLS_PER_TURN="3"
AI_USER_DAILY_TURNS="5000"
AI_PROJECT_DAILY_MODEL_REQUESTS="10000"
STT_USER_DAILY_SECONDS="14400"
TTS_PROJECT_DAILY_REQUESTS="300"
VOICE_MAX_RECORDING_SECONDS="45"
VOICE_MAX_UPLOAD_BYTES="3000000"
